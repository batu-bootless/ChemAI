<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google sign-in in the browser comes back here (src/mobile/googleSignIn.ts):
                 com.chemai.app://auth-callback, com.chemai.app.test://auth-callback in test builds. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!-- Iris reads text off photos with ML Kit's on-device Latin model, installed by
             Google Play services together with the app. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Android 11+ only lets the app see the services it names here: the speech recognizer and
         text-to-speech engine (Iris's voice mode, Voice.java) and the camera app a photo
         question is taken with (<input capture> in the WebView). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Iris's voice (Voice.java) picks Google's network voices only when the phone is online. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Iris's voice mode and dictation (Voice.java); asked for when first used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- RECORD_AUDIO implies a microphone; without this the app would be hidden from every
         device that has none (many tablets), and talking to Iris is an optional extra. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Alarms of the timers Iris sets (src/lib/agent/timers.ts): the notification permission and
         the buzz that goes with the alarm come from @capacitor/local-notifications. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The plugin asks for exact alarms; Chem AI does not need them (a study timer tolerates the
         few seconds Doze may add) and they would need a Play Console declaration. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
</manifest>
